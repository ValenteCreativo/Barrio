# Copia este archivo como .env (que debe estar en .gitignore) y NUNCA subas
# valores reales a git. En produccion estos valores los inyecta el entorno
# de hosting (App Service/Container Apps) o un secret manager, no un archivo.

BARRIO_DB_SERVER=<tu-servidor>.database.windows.net
BARRIO_DB_NAME=BarrioDB
# AUTH_MODE: "azure-ad" (recomendado, usa Managed Identity / az login)
#            "sql-password" (solo para desarrollo local aislado)
BARRIO_DB_AUTH_MODE=azure-ad

# Solo si BARRIO_DB_AUTH_MODE=sql-password (no usar en produccion):
BARRIO_DB_USER=
BARRIO_DB_PASSWORD=
